# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Supabase configuration for persistent agent memory (server-side only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Auth (browser / frontend) — safe to expose, used by the anon client.
# The VITE_ prefix exposes these to the client bundle via import.meta.env.
# NEVER put the service_role key in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# EXTRA_CA_CERTS: Optional. Absolute path to a PEM bundle of trusted CA certs.
# Set this only if you are behind a corporate TLS-intercepting proxy and see
# UNABLE_TO_GET_ISSUER_CERT_LOCALLY errors. Export your OS trust store to a PEM
# file and point this at it. Read at runtime and applied to Node's global fetch.
EXTRA_CA_CERTS=
